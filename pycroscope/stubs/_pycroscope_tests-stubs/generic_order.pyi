from typing import Generic, Protocol, TypeVar

from typing_extensions import Protocol as ExtensionsProtocol

T_co = TypeVar("T_co", covariant=True)
U_co = TypeVar("U_co", covariant=True)

class Base(Protocol[U_co]):
    def get(self) -> U_co: ...

class Reordered(Base[U_co], Protocol[T_co, U_co]):
    def first(self) -> T_co: ...

class ExtensionsReordered(Base[U_co], ExtensionsProtocol[T_co, U_co]):
    def first(self) -> T_co: ...

class GenericReordered(Base[U_co], Generic[T_co, U_co]):
    def first(self) -> T_co: ...

def make() -> Reordered[int, str]: ...
def make_extensions() -> ExtensionsReordered[int, str]: ...
def make_generic() -> GenericReordered[int, str]: ...
def get_base(value: Base[U_co]) -> U_co: ...
